{
  "version": 2,
  "builds": [
    {
      "functions": {
        "api/**/*.js": {
          "runtime": "nodejs18.x"
        }
      }
    }

  ],
  "routes": [
    {
      "source": "/admin/:match*",
      "destination": "/admin/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}