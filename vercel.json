{
  "version": 2,
  "builds": [
    {
      "functions": {
        "api/**/*.js": {
          "runtime": "nodejs18.x"
        }
      }
    }

  ],
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "/public/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
